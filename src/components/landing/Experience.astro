---
// Define testimonials/descriptions data
const experiences = [
  {
    name: "Digital Marketing Specialist – Awayke Talent Solutions",
    year: "Noviembre 2024 - Actualidad",
    location: "Campello, Alicante",
    longDescription: 
        "Participo en la estrategia digital de la empresa, creando contenido para redes sociales, gestionando campañas y analizando resultados. Tras las prácticas, continué como freelance, ampliando mi experiencia en marketing digital en un entorno dinámico."
  },
  {
    name: "Asesor de viajes Oficina de turismo Antibes - Juan-les-Pins",
    location: "Antibes, Francia",
    year: "Verano de 2024",
    longDescription: 
        "Fui el primer contacto para turistas nacionales e internacionales, ofreciendo atención personalizada por distintos canales y facilitando información útil sobre la ciudad. Esta experiencia reforzó mi capacidad de comunicación y orientación al cliente."
  },
  {
    name: "Producción audiovisual cultural – Amis d’Arcabas",
    location: "Toulouse, Francia",
    year: "Noviembre – Marzo 2024",
    longDescription: 
        "Desarrollé un vídeo de mediación cultural desde la idea inicial hasta la postproducción, gestionando guión, casting, presupuesto y edición. Aprendí a liderar proyectos creativos dentro del ámbito cultural, con enfoque narrativo y colaborativo."
  },
  {
    name: "Auxiliar de conversación en francés IES A Cachada - Boiro",
    location: "Boiro, A Coruña",
    year: "2022 - 2023",
    longDescription:
        "Tras licenciarme en Información y Comunicación, trabajé un año como auxiliar de conversación de francés en un instituto, donde preparaba clases y actividades adaptadas a distintos niveles. Esta experiencia fortaleció mi capacidad de adaptación y organización."
    },
  {
    name: "Prácticas en Relaciones con la Prensa – Oficina de Turismo de Niza",
    location: "Niza, Francia",
    year: "Verano de 2021",
    longDescription:
        "Colaboré en la comunicación institucional y turística, usando la herramienta Meltwater para el seguimiento mediático, redactando comunicados de prensa y ofreciendo soporte informativo a periodistas. Esta experiencia fortaleció mis habilidades comunicativas en un entorno profesional y orientado al detalle."
}
];
---

<section class="bg-primary">
  <div class="px-8 2xl:max-w-7xl mx-auto py-6">
    <div class="mt-6 space-y-2">
      <div class="h-0.5 bg-secondary"></div>
      <h3 class="text-secondary text-base font-medium">
        <span>Mi</span>
        <span class="font-bold">experiencia</span>
      </h3>
      <div class="h-1.5 bg-secondary"></div>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-5 text-secondary gap-6 pt-2 mt-2">
      {
        experiences.map((description) => (
         <div>
            <p class="italic text-2xl block font-bold">
              {description.name}
            </p>
            <small> {description.year}</small>
            <br>
            <small>{description.location}</small>
            <p class="text-xs leading-relaxed mt-6">
              {description.longDescription}
            </p>
         </div>
        ))
      }
    </div>
  </div>
</section>
